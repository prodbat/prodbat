# Copy to .env and fill in. Used by compose.yaml.

# Any long random string; it is the database password.
POSTGRES_PASSWORD=change-me

# The address people's browsers reach this server at.
PRODBAT_PUBLIC_URL=https://prodbat.yourdomain.com

# How many reverse proxies sit in front of the server and add to
# X-Forwarded-For. 1 for a single Caddy or nginx. If this is wrong, every
# visitor looks like the same person.
PRODBAT_PROXY_HOPS=1

# Lets `npx prodbat init --token ...` create projects over the network.
# Leave empty to only allow `add-site` on the server itself.
PRODBAT_ADMIN_TOKEN=

# Outgoing email, through any SMTP provider. Without PRODBAT_SMTP_HOST
# alerts are printed in the log instead of sent.
PRODBAT_SMTP_HOST=
PRODBAT_SMTP_PORT=587
PRODBAT_SMTP_USER=
PRODBAT_SMTP_PASSWORD=
PRODBAT_MAIL_FROM=alerts@yourdomain.com

# How many days of visits, errors and checks to keep.
PRODBAT_KEEP_DAYS=365

# How many days of log lines to keep, and how many lines a minute one site
# may send before the rest are dropped. Logs are the bulk of the database:
# raise the days only if you have the disk for it.
PRODBAT_LOG_KEEP_DAYS=7
PRODBAT_LOG_LINES_PER_MINUTE=3000

# Optional: alerts in Slack. Create a Slack app from the manifest in
# docs/self-hosting.md and put its credentials here; without them the
# project page doesn't offer Slack.
PRODBAT_SLACK_CLIENT_ID=
PRODBAT_SLACK_CLIENT_SECRET=

# Optional: a URL to request once a minute, so something outside can tell
# you when this server itself has stopped (any "dead man's switch" service).
PRODBAT_WATCHER_URL=
